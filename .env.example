AGENTEVAL_API_TOKEN=replace-with-a-long-random-team-token
AGENTEVAL_DATABASE_URL=sqlite:///./data/agenteval.db
# HTTP agents must match an exact hostname:port entry; redirects are disabled.
AGENTEVAL_HTTP_ALLOWLIST=127.0.0.1:9001,localhost:9001
# Used only by Docker Compose; use URL-safe random characters for this password.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# local uses the same persisted job/lease protocol without requiring Redis.
AGENTEVAL_EXECUTION_MODE=local
AGENTEVAL_BROKER_URL=redis://127.0.0.1:6379/0
AGENTEVAL_LEASE_SECONDS=30
AGENTEVAL_PROJECT_CONCURRENCY=8
AGENTEVAL_ADMIN_TOKEN=
# Configure in API and Worker environments; never put credentials in profiles.
AGENTEVAL_JUDGE_ENDPOINT=
AGENTEVAL_JUDGE_MODEL=
AGENTEVAL_JUDGE_API_KEY=
AGENTEVAL_JUDGE_MAX_CALLS=100
# Isolated local state fixtures; API/Worker deployment-owned adapters only.
AGENTEVAL_ENVIRONMENT_ROOT=./data/environments
# Optional independent HTTP RAG services; add exact host:port to HTTP_ALLOWLIST.
AGENTEVAL_RETRIEVER_ENDPOINT=
AGENTEVAL_RERANKER_ENDPOINT=

